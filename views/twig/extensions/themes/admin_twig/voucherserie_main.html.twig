{% extends "voucherserie_main.html.twig" %}

{% block admin_voucherserie_main_form_discount_type %}
    {% d3modcfgcheck modid="d3articlevoucher" %}{% endd3modcfgcheck %}

    {# Hinweis-Meldung anzeigen, wenn Modul nicht Aktiv bzw. Lizenzschlüssel fehlt #}
    {% if not mod_d3articlevoucher %}
        {% block d3d3articlevoucher_modul_not_active %}
            <tr>
                <td colspan="2">
                    <div class="extension_error">
                        {{ translate({ ident: "D3ARTVOUCHER_MODUL_NOT_ACTIVE" }) }}
                    </div>
                </td>
            </tr>
        {% endblock %}

        {{ parent() }}
    {% else %}
        <tr>
            <td class="edittext">
                <label for="oxdiscount">{{ translate({ ident: "VOUCHERSERIE_MAIN_DISCOUNT" }) }}</label>
            </td>
            <td class="edittext">
                <input id="oxdiscount" {% if not blD3DisplayItem %}style="display:none;"{% endif %} class="editinput" type="text" size="15" name="editval[oxvoucherseries__oxdiscount]" value="{{ edit.oxvoucherseries__oxdiscount.value }}" onClick="this.select()" {{ readonly }}>
                <select class="editinput" name="editval[oxvoucherseries__oxdiscounttype]" onChange="ChangeVoucherType(this);" {{ readonly }}>
                    <option value="absolute" {% if edit.oxvoucherseries__oxdiscounttype.value == "absolute" %}selected{% endif %}>
                        {{ translate({ ident: "D3_VOUCHERSERIE_MAIN_DISCOUNT_ABS" }) }}
                    </option>
                    <option value="percent" {% if edit.oxvoucherseries__oxdiscounttype.value == "percent" %}selected{% endif %}>
                        {{ translate({ ident: "D3_VOUCHERSERIE_MAIN_DISCOUNT_PERCENT" }) }}
                    </option>
                    <option value="discount" {% if edit.oxvoucherseries__oxdiscounttype.value == "discount" %}selected{% endif %}>
                        {{ translate({ ident: "D3_VOUCHERSERIE_MAIN_DISCOUNT_ITEM" }) }}
                    </option>
                </select>
                {% include "inputhelp.html.twig" with {'sHelpId': help_id("D3_HELP_VOUCHERSERIE_MAIN_DISCOUNT"), 'sHelpText': help_text("D3_HELP_VOUCHERSERIE_MAIN_DISCOUNT")} %}
            </td>
        </tr>
        <tr id="itmart" {% if blD3DisplayItem %}style="display: none;"{% endif %}>
            <td class="edittext">
                <label for="d3discountid">{{ translate({ ident: "VOUCHERSERIE_MAIN_DISCOUNT" }) }}</label>
            </td>
            <td class="edittext">
                <select id="d3discountid" name="editval[oxvoucherseries__d3discountid]" class="editinput" style="width:220px;" {{ readonly }}>
                    <option value="">---</option>
                    {% for discount in discountlist %}
                        <option value="{{ discount.oxdiscount__oxid.value }}" {% if edit.oxvoucherseries__d3discountid.value == discount.getId() %}SELECTED{% endif %}>
                            {{ discount.oxdiscount__oxtitle.value }}
                        </option>
                    {% endfor %}
                </select>
            </td>
        </tr>
    {% endif %}
    {# D3 ArticleVoucher #}
{% endblock %}